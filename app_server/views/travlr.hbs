{{> header}}

<main>
    <h2>{{message}}</h2>

    <section>
        <h3>Featured Travel Packages</h3>

        {{#each packages}}
        <div>
            <h4>{{name}}</h4>
            <p>{{description}}</p>
            <p>Starting at {{price}}</p>
        </div>
        {{/each}}

    </section>
</main>

{{> footer}}