<header>
    <h1>{{title}}</h1>

    <nav>
        <a href="/">Home</a> |
        <a href="/travel">Travel</a> |
        <a href="/rooms">Rooms</a> |
        <a href="/meals">Meals</a> |
        <a href="/news">News</a> |
        <a href="/contact">Contact</a>
    </nav>
</header>

<main>
    <h2>{{message}}</h2>

    <section>
        <h3>Featured Travel Packages</h3>

        {{#each packages}}
        <div>
            <h4>{{name}}</h4>
            <p>{{description}}</p>
            <p>Starting at {{price}}</p>
        </div>
        {{/each}}

    </section>
</main>